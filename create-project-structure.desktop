[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=inode/directory
Actions=create_structure
X-KDE-Submenu=Creator Toolkit
Icon=applications-accessories

[Desktop Action create_structure]
Name=Create project folders (a-roll, b-roll, img, thumb, extras)
Name[pt_BR]=Criar pastas de projeto (a-roll, b-roll, img, thumb, extras)
Icon=folder-new
Exec=konsole -e ~/.local/share/kio/servicemenus/create-project-structure.sh %f\nX-KDE-Submenu="Creator Toolkit"

# This menu executes the create-project-structure.sh script to create a standard project structure with a-roll, b-roll, img, thumb, and extras folders.
# Este menu executa o script create-project-structure.sh para criar uma estrutura de projeto padrão com pastas de a-roll, b-roll, img, thumb e extras.
