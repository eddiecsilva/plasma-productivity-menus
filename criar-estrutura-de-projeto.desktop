[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=inode/directory
Actions=criar_estrutura

[Desktop Action criar_estrutura]
Name=Criar pastas de projeto (a-roll, b-roll, img, thumb, extras)
Icon=folder-new
Exec=konsole -e bash -c 'for dir in "a-roll" "b-roll" "img" "thumb" "extras"; do mkdir -p "%f/$dir" && echo "📁 Criada: %f/$dir"; done'\nX-KDE-Submenu="Estrutura Vídeo"