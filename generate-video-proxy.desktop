[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=video/*
Actions=proxy
X-KDE-Submenu=Creator Toolkit
Icon=applications-accessories

[Desktop Action proxy]
Name=Generate light video proxy
Name[pt_BR]=Gerar Proxy de Vídeo Leve
Exec=konsole -e ~/.local/share/kio/servicemenus/generate-video-proxy-parallel.sh %F
Icon=video-x-generic

# This menu executes the generate-video-proxy-parallel.sh script to create a lightweight video proxy (1080p) for editing.
# Este menu executa o script generate-video-proxy-parallel.sh para gerar um proxy de vídeo leve (1080p) para edição.
