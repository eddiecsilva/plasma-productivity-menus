[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=video/*
Actions=recodificar_alac
[Desktop Action recodificar_alac]
Name=Recodificar Áudio para ALAC (sem perdas)
Exec=konsole --hold -e ~/.local/share/kio/servicemenus/recodificar-audio-ALAC.sh %F
Icon=audio-x-generic
X-KDE-Submenu="Edição de Vídeo"
